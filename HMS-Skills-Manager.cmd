@echo off
setlocal
set "HMS_MANAGER_ROOT=%~dp0"
powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -Command "$ErrorActionPreference='Stop'; $root=[IO.Path]::GetFullPath($env:HMS_MANAGER_ROOT).TrimEnd([char]92); $head=((& git -C $root rev-parse HEAD 2>$null)-join '').Trim().ToLowerInvariant(); if($LASTEXITCODE -ne 0 -or $head -notmatch '^[0-9a-f]{40}$'){throw 'Manager launcher could not resolve a canonical HMS HEAD.'}; $spec=$head+':manager/HmsSuperpowersManager.ps1'; $expected=((& git -C $root rev-parse $spec 2>$null)-join '').Trim().ToLowerInvariant(); if($LASTEXITCODE -ne 0 -or $expected -notmatch '^[0-9a-f]{40}$'){throw 'Manager launcher could not resolve the committed Manager shim blob.'}; $type=((& git -C $root cat-file -t $expected 2>$null)-join '').Trim().ToLowerInvariant(); if($LASTEXITCODE -ne 0 -or $type -cne 'blob'){throw 'Manager launcher expected a committed blob for the Manager shim.'}; $path=Join-Path $root 'manager\HmsSuperpowersManager.ps1'; $fs=[IO.File]::Open($path,[IO.FileMode]::Open,[IO.FileAccess]::Read,[IO.FileShare]::Read); try{if($fs.Length -gt [int]::MaxValue){throw 'Manager shim is too large.'}; $bytes=New-Object byte[] ([int]$fs.Length); $offset=0; while($offset -lt $bytes.Length){$n=$fs.Read($bytes,$offset,$bytes.Length-$offset); if($n -le 0){throw 'Manager shim ended before snapshot completion.'}; $offset+=$n}}finally{$fs.Dispose()}; $header=[Text.Encoding]::ASCII.GetBytes(('blob '+[string]$bytes.Length+[char]0)); $sha=[Security.Cryptography.SHA1]::Create(); $ms=New-Object IO.MemoryStream; try{$ms.Write($header,0,$header.Length); if($bytes.Length -gt 0){$ms.Write($bytes,0,$bytes.Length)}; $ms.Position=0; $actual=(($sha.ComputeHash($ms)|ForEach-Object{$_.ToString('x2')})-join '')}finally{$ms.Dispose();$sha.Dispose()}; if($actual -cne $expected){throw ('Manager launcher rejected uncommitted shim bytes. Expected '+$expected+', found '+$actual+'.')}; $source=(New-Object System.Text.UTF8Encoding($false,$true)).GetString($bytes); $script=[ScriptBlock]::Create($source); if($env:HMS_MANAGER_SELFTEST -ceq '1'){& $script -SelfTest -TrustedRepoRoot $root -TrustedHead $head -TrustedBootstrapBlob $expected}else{& $script -TrustedRepoRoot $root -TrustedHead $head -TrustedBootstrapBlob $expected}"
set "RC=%ERRORLEVEL%"
if not "%RC%"=="0" echo HMS Skills Manager exited with an error.
exit /b %RC%
